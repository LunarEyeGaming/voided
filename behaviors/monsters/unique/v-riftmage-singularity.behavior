{
  "name": "v-riftmage-singularity",
  "description": "",
  "scripts": [
    "/scripts/actions/math.lua",
    "/scripts/actions/animator.lua",
    "/scripts/actions/time.lua",
    "/scripts/actions/monster.lua"
  ],
  "parameters": {
    "windupState": "",
    "windupStateType": "",
    "windupTime": 1,
    "activeState": "",
    "activeStateType": "",
    "activeTime": 2,
    "winddownState": "",
    "winddownStateType": "",
    "winddownTime": 0.5,
    "activeEmitter": null,
    "activeForceRegion": null,
    "rotateRate": 0,
    "rotateGroup": "body",
    "rotateCenter": [0, 0],
    "teleportStopForce": 50,
    "teleportStateType": ""
  },
  "root": {
    "title": "sequence",
    "type": "composite",
    "name": "sequence",
    "parameters": {},
    "children": [
      {
        "title": "multiply",
        "type": "action",
        "name": "multiply",
        "parameters": {
          "factor": {"key": "<rotateRate>"},
          "number": {"key": "<activeTime>"}
        },
        "output": {
          "result": "totalRotation"
        }
      },
      {
        "title": "sequence",
        "type": "composite",
        "name": "sequence",
        "parameters": {},
        "children": [
          {
            "title": "v-action-teleportout",
            "type": "module",
            "name": "v-action-teleportout",
            "parameters": {
              "stateType": {"key": "<teleportStateType>"},
              "stopForce": {"key": "<teleportStopForce>"}
            }
          },
          {
            "title": "resetTransformationGroup",
            "type": "action",
            "name": "resetTransformationGroup",
            "parameters": {
              "transformationGroup": {"key": "<rotateGroup>"}
            }
          },
          {
            "title": "v-action-teleportin",
            "type": "module",
            "name": "v-action-teleportin",
            "parameters": {
              "maxAngle": {"value": 6.3},
              "minAngle": {"value": 0},
              "teleportDistance": {"value": 0},
              "stateType": {"key": "<teleportStateType>"}
            }
          }
        ]
      },
      {
        "title": "succeeder",
        "type": "decorator",
        "name": "succeeder",
        "parameters": {},
        "child": {
          "title": "setAnimationState",
          "type": "action",
          "name": "setAnimationState",
          "parameters": {
            "state": {"key": "<windupState>"},
            "type": {"key": "<windupStateType>"}
          }
        }
      },
      {
        "title": "timer",
        "type": "action",
        "name": "timer",
        "parameters": {
          "time": {"key": "<windupTime>"}
        }
      },
      {
        "title": "succeeder",
        "type": "decorator",
        "name": "succeeder",
        "parameters": {},
        "child": {
          "title": "setAnimationState",
          "type": "action",
          "name": "setAnimationState",
          "parameters": {
            "state": {"key": "<activeState>"},
            "type": {"key": "<activeStateType>"}
          }
        }
      },
      {
        "title": "parallel",
        "type": "composite",
        "name": "parallel",
        "parameters": {
          "fail": {"value": -1},
          "success": {"value": 1}
        },
        "children": [
          {
            "title": "failer",
            "type": "decorator",
            "name": "failer",
            "parameters": {},
            "child": {
              "title": "setForceRegionActive",
              "type": "action",
              "name": "setForceRegionActive",
              "parameters": {
                "name": {"key": "<activeForceRegion>"}
              }
            }
          },
          {
            "title": "emitParticles",
            "type": "action",
            "name": "emitParticles",
            "parameters": {
              "emitter": {"key": "<activeEmitter>"}
            }
          },
          {
            "title": "timer",
            "type": "action",
            "name": "timer",
            "parameters": {
              "time": {"key": "<activeTime>"}
            },
            "output": {
              "ratio": "progress"
            }
          },
          {
            "title": "failer",
            "type": "decorator",
            "name": "failer",
            "parameters": {},
            "child": {
              "title": "sequence",
              "type": "composite",
              "name": "sequence",
              "parameters": {},
              "children": [
                {
                  "title": "lerp",
                  "type": "action",
                  "name": "lerp",
                  "parameters": {
                    "max": {"key": "totalRotation"},
                    "min": {"value": 0},
                    "ratio": {"key": "progress"}
                  },
                  "output": {
                    "number": "rotation"
                  }
                },
                {
                  "title": "resetTransformationGroup",
                  "type": "action",
                  "name": "resetTransformationGroup",
                  "parameters": {
                    "transformationGroup": {"key": "<rotateGroup>"}
                  }
                },
                {
                  "title": "rotateTransformationGroup",
                  "type": "action",
                  "name": "rotateTransformationGroup",
                  "parameters": {
                    "angle": {"key": "rotation"},
                    "rotationCenter": {"key": "<rotateCenter>"},
                    "transformationGroup": {"key": "<rotateGroup>"}
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "title": "succeeder",
        "type": "decorator",
        "name": "succeeder",
        "parameters": {},
        "child": {
          "title": "setAnimationState",
          "type": "action",
          "name": "setAnimationState",
          "parameters": {
            "state": {"key": "<winddownState>"},
            "type": {"key": "<winddownStateType>"}
          }
        }
      },
      {
        "title": "timer",
        "type": "action",
        "name": "timer",
        "parameters": {
          "time": {"key": "<winddownTime>"}
        }
      }
    ]
  }
}