{
  "name": "v-approach-flytosurface",
  "description": "",
  "scripts": [
    "/scripts/actions/v-world.lua",
    "/scripts/behavior/bdata.lua",
    "/scripts/actions/voidedutil.lua",
    "/scripts/actions/movement.lua",
    "/scripts/actions/animator.lua",
    "/scripts/actions/projectiles.lua",
    "/scripts/actions/position.lua",
    "/scripts/actions/v-movement.lua"
  ],
  "parameters": {
    "flightTolerance": 1,
    "stopForce": 50,
    "selectionRayCount": 20,
    "selectionMinRaycastLength": null,
    "selectionMaxRaycastLength": 50,
    "selectionCollisionSet": null,
    "flyState": "",
    "idleState": "",
    "stateType": "",
    "selectionMaxCorrection": 3
  },
  "root": {
    "title": "sequence",
    "type": "composite",
    "name": "sequence",
    "parameters": {},
    "children": [
      {
        "title": "sequence",
        "type": "composite",
        "name": "sequence",
        "parameters": {},
        "children": [
          {
            "title": "v_radialRaycast",
            "type": "action",
            "name": "v_radialRaycast",
            "parameters": {
              "center": {"key": "self"},
              "collisionSet": {"key": "<selectionCollisionSet>"},
              "maxRaycastLength": {"key": "<selectionMaxRaycastLength>"},
              "minRaycastLength": {"key": "<selectionMinRaycastLength>"},
              "rayCount": {"key": "<selectionRayCount>"}
            },
            "output": {
              "result": "raycastResults"
            }
          },
          {
            "title": "listShuffle",
            "type": "action",
            "name": "listShuffle",
            "parameters": {
              "list": {"key": "raycastResults"}
            },
            "output": {
              "list": "raycastResults"
            }
          },
          {
            "title": "v_listGet2",
            "type": "action",
            "name": "v_listGet2",
            "parameters": {
              "list": {"key": "raycastResults"}
            },
            "output": {
              "json": "raycastResult"
            }
          },
          {
            "title": "v_getJsonKey",
            "type": "action",
            "name": "v_getJsonKey",
            "parameters": {
              "key": {"value": "position"},
              "object": {"key": "raycastResult"}
            },
            "output": {
              "position": "flightPosition"
            }
          },
          {
            "title": "v_resolvePolyCollision",
            "type": "action",
            "name": "v_resolvePolyCollision",
            "parameters": {
              "maxCorrection": {"key": "<selectionMaxCorrection>"},
              "position": {"key": "flightPosition"},
              "useBoundBox": {"value": true}
            },
            "output": {
              "result": "flightPositionBB"
            }
          },
          {
            "title": "v_resolvePolyCollision",
            "type": "action",
            "name": "v_resolvePolyCollision",
            "parameters": {
              "maxCorrection": {"key": "<selectionMaxCorrection>"},
              "position": {"key": "flightPosition"}
            },
            "output": {
              "result": "flightPosition"
            }
          }
        ]
      },
      {
        "title": "parallel",
        "type": "composite",
        "name": "parallel",
        "parameters": {
          "fail": {"value": -1},
          "success": {"value": 1}
        },
        "children": [
          {
            "title": "failer",
            "type": "decorator",
            "name": "failer",
            "parameters": {},
            "child": {
              "title": "sequence",
              "type": "composite",
              "name": "sequence",
              "parameters": {},
              "children": [
                {
                  "title": "controlParameters",
                  "type": "action",
                  "name": "controlParameters",
                  "parameters": {
                    "parameters": {"value": {"gravityEnabled": false}}
                  }
                }
              ]
            }
          },
          {
            "title": "failer",
            "type": "decorator",
            "name": "failer",
            "parameters": {},
            "child": {
              "title": "animate",
              "type": "action",
              "name": "animate",
              "parameters": {
                "fallback": {"key": "<idleState>"},
                "state": {"key": "<flyState>"},
                "type": {"key": "<stateType>"}
              }
            }
          },
          {
            "title": "failer",
            "type": "decorator",
            "name": "failer",
            "parameters": {},
            "child": {
              "title": "spawnProjectile",
              "type": "action",
              "name": "spawnProjectile",
              "parameters": {
                "angle": {"value": 0},
                "offset": {"value": [0, 0]},
                "position": {"key": "flightPosition"},
                "projectileConfig": {"value": {}},
                "projectileType": {"value": "v-proxyprojectile"},
                "scalePower": {"value": true},
                "sourceEntity": {"key": "self"},
                "trackSource": {"value": false},
                "uniqueRepeatGroup": {"value": true}
              }
            }
          },
          {
            "title": "failer",
            "type": "decorator",
            "name": "failer",
            "parameters": {},
            "child": {
              "title": "spawnProjectile",
              "type": "action",
              "name": "spawnProjectile",
              "parameters": {
                "angle": {"value": 0},
                "offset": {"value": [0, 0]},
                "position": {"key": "flightPositionBB"},
                "projectileConfig": {"value": {}},
                "projectileType": {"value": "v-proxyprojectile"},
                "scalePower": {"value": true},
                "sourceEntity": {"key": "self"},
                "trackSource": {"value": false},
                "uniqueRepeatGroup": {"value": true}
              }
            }
          },
          {
            "title": "failer",
            "type": "decorator",
            "name": "failer",
            "parameters": {},
            "child": {
              "title": "sequence",
              "type": "composite",
              "name": "sequence",
              "parameters": {},
              "children": [
                {
                  "title": "distance",
                  "type": "action",
                  "name": "distance",
                  "parameters": {
                    "from": {"key": "self"},
                    "to": {"key": "flightPosition"}
                  },
                  "output": {
                    "vector": "flightVector",
                    "x": "flightDirection"
                  }
                },
                {
                  "title": "faceDirection",
                  "type": "action",
                  "name": "faceDirection",
                  "parameters": {
                    "direction": {"key": "flightDirection"}
                  }
                }
              ]
            }
          },
          {
            "title": "sequence",
            "type": "composite",
            "name": "sequence",
            "parameters": {},
            "children": [
              {
                "title": "v_flyToPositionNoFlip",
                "type": "action",
                "name": "v_flyToPositionNoFlip",
                "parameters": {
                  "position": {"key": "flightPosition"},
                  "tolerance": {"key": "<flightTolerance>"}
                }
              },
              {
                "title": "v_stop",
                "type": "action",
                "name": "v_stop",
                "parameters": {
                  "stopForce": {"key": "<stopForce>"}
                }
              }
            ]
          }
        ]
      }
    ]
  }
}