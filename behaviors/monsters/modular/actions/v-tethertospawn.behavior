{
  "name": "v-action-tether",
  "description": "",
  "scripts": [
    "/scripts/actions/position.lua",
    "/scripts/actions/math.lua",
    "/scripts/actions/animator.lua",
    "/scripts/actions/voidedutil.lua"
  ],
  "parameters": {
    "tetherOffset": [0, 0],
    "maxTetherLength": 50,
    "tetherDirection": [0, -1]
  },
  "root": {
    "title": "sequence",
    "type": "composite",
    "name": "sequence",
    "parameters": {},
    "children": [
      {
        "title": "distance (uses result from v-action-gettetherposition)",
        "type": "action",
        "name": "distance",
        "parameters": {
          "from": {"key": "self"},
          "to": {"key": "__tetherEndPosition"}
        },
        "output": {
          "magnitude": "beamLength",
          "vector": "beamVector"
        }
      },
      {
        "title": "vecAngle",
        "type": "action",
        "name": "vecAngle",
        "parameters": {
          "vector": {"key": "beamVector"}
        },
        "output": {
          "angle": "beamAngle"
        }
      },
      {
        "title": "resetTransformationGroup",
        "type": "action",
        "name": "resetTransformationGroup",
        "parameters": {
          "transformationGroup": {"value": "tether"}
        }
      },
      {
        "title": "scaleTransformationGroup",
        "type": "action",
        "name": "scaleTransformationGroup",
        "parameters": {
          "scale": {"value": ["beamLength", 1]},
          "transformationGroup": {"value": "tether"}
        }
      },
      {
        "title": "rotateTransformationGroup",
        "type": "action",
        "name": "rotateTransformationGroup",
        "parameters": {
          "angle": {"key": "beamAngle"},
          "rotationCenter": {"key": "<tetherOffset>"},
          "transformationGroup": {"value": "tether"}
        }
      },
      {
        "title": "v_logInfo",
        "type": "action",
        "name": "v_logInfo",
        "parameters": {
          "formatArgs": {"value": ["$number:beamAngle", "$number:beamLength"]},
          "msg": {"value": "%s %s"}
        }
      }
    ]
  }
}