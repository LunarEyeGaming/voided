{
  "name": "v-action-wormfigure8instant",
  "description": null,
  "scripts": [
    "/scripts/actions/time.lua",
    "/scripts/actions/position.lua",
    "/scripts/actions/math.lua",
    "/scripts/actions/v-worm.lua"
  ],
  "parameters": {
    "size": 100,
    "numPoints": 60,
    "speed": 10,
    "offset": [0, 0],
    "delay": 0
  },
  "root": {
    "title": "sequence",
    "type": "composite",
    "name": "sequence",
    "parameters": {},
    "children": [
      {
        "title": "timer",
        "type": "action",
        "name": "timer",
        "parameters": {
          "time": {"key": "<delay>"}
        }
      },
      {
        "title": "offsetPosition",
        "type": "action",
        "name": "offsetPosition",
        "parameters": {
          "offset": {"key": "<offset>"},
          "position": {"key": "self"}
        },
        "output": {
          "position": "center"
        }
      },
      {
        "title": "multiply",
        "type": "action",
        "name": "multiply",
        "parameters": {
          "factor": {"value": -1},
          "number": {"value": "<size>"}
        },
        "output": {
          "result": "xOffset"
        }
      },
      {
        "title": "v_wormFigure8Instant",
        "type": "action",
        "name": "v_wormFigure8Instant",
        "parameters": {
          "center": {"key": "center"},
          "numPoints": {"key": "<numPoints>"},
          "size": {"key": "<size>"}
        }
      }
    ]
  }
}