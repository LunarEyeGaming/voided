{
  "projectileName" : "v-hailpellet1",
  "image" : "hailpellet1.png",
  // "physics" : "stickygrenade",
  "physics" : "grenade",
  "animationCycle" : 0.5,
  "bounces" : 0,
  "frameNumber" : 1,
  "damageKindImage" : "icon.png",
  "pointLight" : false,
  "flippable" : true,
  "power" : 100.0,
  "damageKind" : "ice",
  "timeToLive" : 5,
  // "speed" : 50,

  // "damagePoly" : [ [-9, 0], [-6, -6], [0, -9], [6, -6], [9, 0], [6, 6], [0, 9], [-6, 6] ],

  "scripts" : [ "/scripts/projectiles/v-mergehandler.lua", "v-hailpelletplugin.lua" ],

  "speedRange" : [15, 25],
  "addYVelocity" : 10,

  "mergeRadius" : 2,
  "mergeHandlerType" : "v-hailcloud",
  "mergeDelay" : 0,

  "actionOnMerge" : {
    "action" : "projectile",
    "type" : "v-hailpellet2",
    "inheritDamageFactor" : 1.35,
    "inheritSpeedFactor" : 0.85,
    "angle" : 90
  },
  "actionOnNonMerge" : {
    "action" : "projectile",
    "type" : "v-proxyprojectile",
    "config" : {
      "actionOnReap" : [
        {
          "action" : "loop",
          "count" : 3,
          "body" : [
            {
              "action" : "particle",
              "specification" : "v-permafrostshard"
            }
          ]
        },
        {
          "action" : "sound",
          "options" : [ "/sfx/projectiles/ice_break1.ogg", "/sfx/projectiles/ice_break2.ogg",
          "/sfx/projectiles/ice_break3.ogg", "/sfx/projectiles/ice_break4.ogg", "/sfx/projectiles/ice_break5.ogg",
          "/sfx/projectiles/ice_break6.ogg", "/sfx/projectiles/ice_break7.ogg", "/sfx/projectiles/ice_break8.ogg",
          "/sfx/projectiles/ice_break9.ogg", "/sfx/projectiles/ice_break10.ogg" ]
        }
      ]
    }
  }
}