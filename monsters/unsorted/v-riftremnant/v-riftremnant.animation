{
  "animatedParts" : {
    "stateTypes" : {
      "body" : {
        "default" : "appear",
        "states" : {
          "appear" : {
            "frames" : 7,
            "cycle" : 0.7,
            "mode" : "transition",
            "transition" : "idle",
            "properties" : {
              "immediateSound" : "/sfx/environmental/v_riftremnant_form.ogg"
            }
          },
          "idle" : {
            "frames" : 14,
            "cycle" : 1.4,
            "mode" : "loop",
            "properties" : {
              "particleEmittersOn" : [ "emitter" ],
              "persistentSoundFadeTime" : 0.5,
              "persistentSound" : "/sfx/environmental/v_riftremnant_loop.ogg"
            }
          }
        }
      }
    },
    "parts" : {
      "body" : {
        "properties" : {
          "fullbright" : true
        },
        "partStates" : {
          "body" : {
            "appear" : {
              "properties" : {
                "image" : "<partImage>:appear.<frame>"
              }
            },
            "idle" : {
              "properties" : {
                "image" : "<partImage>:idle.<frame>"
              }
            }
          }
        }
      }
    }
  },

  "effects" : {
    "blink" : {
      "type" : "flash",
      "time" : 0.25,
      "directives" : "fade=ffffff;0.5"
    }
  },

  "particleEmitters" : {
    "emitter" : {
      "emissionRate" : 5,
      "particles" : [
        {"particle" : "v-riftremnant"}
      ]
    },
    "deathPoof" : {
      "burstCount" : 10,
      "offsetRegion" : [-2, -2, 2, 2],
      "particles" : [
        { "particle" : "v-riftremnantshard" }
      ]
    }
  },

  "lights" : {
    "glow" : {
      "active" : true,
      "color" : [92, 54, 111]
    }
  },

  "sounds" : {
    "deathPuff" : [ "/sfx/environmental/v_riftremnant_shatter.ogg" ]
  }
}
