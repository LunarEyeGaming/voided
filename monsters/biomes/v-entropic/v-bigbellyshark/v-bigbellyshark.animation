{
  "animatedParts" : {
    "stateTypes" : {
      "movement" : {
        "priority" : 0,
        "default" : "idle",

        "states" : {
          "idle" : {
            "frames" : 1
          },
          "flopping" : {
            "frames" : 2,
            "cycle" : 0.25,
            "mode" : "loop"
          },
          "swimFast" : {
            "frames" : 1,
            "cycle" : 0.6,
            "mode" : "loop"
          },
          "swimSlow" : {
            "frames" : 1,
            "cycle" : 0.9,
            "mode" : "loop"
          }
        }
      },

      "attack" : {
        "priority" : 1,
        "default" : "idle",

        "states" : {
          "idle" : {
            "frames" : 1
          },
          "meleewindup" : {
            "frames" : 1,
            "cycle" : 1
          },
          "melee" : {
            "frames" : 1,
            "cycle" : 0.75,
            "mode" : "transition",
            "transition" : "meleesnap",
            "properties" : {
              "immediateSound" : "/sfx/npc/monsters/oogler_charge.ogg"
            }
          },
          "meleesnap" : {
            "frames" : 1,
            "cycle" : 0.4,
            "mode" : "transition",
            "transition" : "idle",
            "properties" : {
              "immediateSound" : "/sfx/npc/monsters/monster_bite2.ogg"
            }
          },
          "shootwindup" : {
            "frames" : 1
          },
          "shooting" : {
            "frames" : 1
          }
        }
      },

      "releaseParticles" : {
        "default" : "off",
        "states" : {
          "off" : {
            "frames" : 1,
            "properties" : {
              "particleEmittersOff" : [ "releaseParticles" ]
            }
          },
          "on" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "transition",
            "transition" : "off",
            "properties" : {
              "particleEmittersOn" : [ "releaseParticles" ]
            }
          }
        }
      }
    },

    "parts" : {
      "body" : {
