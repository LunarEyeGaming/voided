{
  "animatedParts" : {
    "stateTypes" : {
      "body" : {
        "priority" : 0,
        "default" : "idle",
        "states" : {
          "idle" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "loop",
            "properties" : {
              "lightsOn" : [ "glow" ]
            }
          },
          "aggro" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "loop",
            "properties" : {
              "immediateSound" : "/sfx/melee/sword_guard.ogg",
              "lightsOn" : [ "glow" ]
            }
          },
          "windup" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "loop",
            "properties" : {
              "immediateSound" : "/sfx/melee/sword_guard.ogg"
            }
          },
          "fire" : {
            "frames" : 1,
            "cycle" : 5.0,
            "mode" : "transition",
            "transition" : "aggro",
            "properties" : {
              "lightsOff" : [ "glow" ]
            }
          }
        }
      },
      "damage" : {
        "priority" : 3,
        "default" : "none",
        "states" : {
          "none" : {
            "frames" : 1
          },
          "stunned" : {
            "frames" : 1
          },
          "killed" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "end"
          }
        }
      },
      "releaseParticles" : {
        "default" : "off",
        "states" : {
          "off" : {
            "frames" : 1,
            "properties" : {
              "particleEmittersOff" : [ "releaseParticles" ]
            }
          },
          "on" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "transition",
            "transition" : "off",
            "properties" : {
              "particleEmittersOn" : [ "releaseParticles" ]
            }
          }
        }
      }
    },

    "parts" : {
      "body" : {
