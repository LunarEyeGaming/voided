{
  "animatedParts" : {
    "stateTypes" : {
      "movement" : {
        "priority" : 0,
        "default" : "idle",

        "states" : {
          "idle" : {
            "frames" : 1
          },
          "flopping" : {
            "frames" : 1,
            "cycle" : 0.25,
            "mode" : "loop"
          },
          "swimFast" : {
            "frames" : 6,
            "cycle" : 0.6,
            "mode" : "loop"
          },
          "swimSlow" : {
            "frames" : 6,
            "cycle" : 0.9,
            "mode" : "loop"
          }
        }
      },

      "attack" : {
        "priority" : 1,
        "default" : "idle",

        "states" : {
          "idle" : {
            "frames" : 1
          },
          "meleewindup" : {
            "frames" : 2,
            "cycle" : 0.2,
            "mode" : "transition",
            "transition" : "meleewinduploop"
          },
          "meleewinduploop" : {
            "frames" : 2,
            "cycle" : 0.2,
            "mode" : "loop"
          },
          "melee" : {
            "frames" : 8,
            "cycle" : 0.8,
            "mode" : "transition",
            "transition" : "idle"
          },
          "shootwindup" : {
            "frames" : 2,
            "cycle" : 0.2,
            "mode" : "transition",
            "transition" : "shootwinduploop"
          },
          "shootwinduploop" : {
            "frames" : 2,
            "cycle" : 0.2,
            "mode" : "loop"
          },
          "shooting" : {
            "frames" : 5,
            "cycle" : 0.5,
            "mode" : "transition",
            "transition" : "idle"
          }
        }
      },

      "damage" : {
        "priority" : 3,
        "default" : "none",
        "states" : {
          "none" : {
            "frames" : 1
          },
          "stunned" : {
            "frames" : 1
          }
        }
      },

      "releaseParticles" : {
        "default" : "off",
        "states" : {
          "off" : {
            "frames" : 1,
            "properties" : {
              "particleEmittersOff" : [ "releaseParticles" ]
            }
          },
          "on" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "transition",
            "transition" : "off",
            "properties" : {
              "particleEmittersOn" : [ "releaseParticles" ]
            }
          }
        }
      }
    },

    "parts" : {
      "body" : {
        "properties" : {
          "rotationGroup" : "all",
          "offset" : [-0.5, 0],
          "zLevel" : 2
        },

        "partStates" : {
