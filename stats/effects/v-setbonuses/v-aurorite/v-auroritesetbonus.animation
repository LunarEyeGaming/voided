{
  "globalTagDefaults" : {
    "numHits" : "0"
  },
  "animatedParts" : {
    "stateTypes" : {
      "orb" : {
        "default" : "idle",
        "states" : {
          "idle" : {
            "frames" : 6,
            "cycle" : 0.6,
            "mode" : "loop"
          },
          "invisible" : {}
        }
      },
      "shield" : {
        "default" : "inactive",
        "states" : {
          "broken" : {},
          "inactive" : {},
          "grow" : {
            "frames" : 3,
            "cycle" : 0.1,
            "mode" : "transition",
            "transition" : "active"
          },
          "active" : {},
          "shrink" : {
            "frames" : 3,
            "cycle" : 0.1,
            "mode" : "transition",
            "transition" : "inactive"
          }
        }
      }
    },
    "parts" : {
      "orb" : {
        "properties" : {
          "centered" : true,
          "fullbright" : true
        },
        "partStates" : {
          "orb" : {
            "idle" : {
              "properties" : {
                "image" : "auroritesetbonusorb.png:<frame>"
              }
            }
          }
        }
      },
      "shield" : {
        "properties" : {
          "zLevel" : 1,
          "centered" : true,
          "fullbright" : true
        },
        "partStates" : {
          "shield" : {
            "inactive" : {
              "properties" : {
                "image" : "auroritesetbonus.png:inactive.<numHits>.<frame>"
              }
            },
            "grow" : {
              "properties" : {
                "image" : "auroritesetbonus.png:grow.<numHits>.<frame>"
              }
            },
            "active" : {
              "properties" : {
                "image" : "auroritesetbonus.png:active.<numHits>.<frame>"
              }
            },
            "shrink" : {
              "properties" : {
                "image" : "auroritesetbonus.png:shrink.<numHits>.<frame>"
              }
            }
          }
        }
      }
    }
  },
  "particleEmitters" : {
    "crack" : {
      "particles" : [
        { "count" : 2, "particle" : "prismshard" },
        { "count" : 5, "particle" : "prismfineshard" }
      ]
    },
    "break" : {
      "particles" : [
        { "count" : 10, "particle" : "prismshard" },
        { "count" : 20, "particle" : "prismfineshard" }
      ]
    }
  },
  "sounds" : {
    "deploy" : [ "/sfx/statuseffects/v_iceshield_deploy.ogg" ],
    "retract" : [ "/sfx/statuseffects/v_iceshield_retract.ogg" ],
    "crack" : [ "/sfx/objects/prism_break_small1.ogg", "/sfx/objects/prism_break_small2.ogg", "/sfx/objects/prism_break_small3.ogg" ],
    "break" : [ "/sfx/objects/prism_break_large1.ogg", "/sfx/objects/prism_break_large2.ogg" ]
  }
}